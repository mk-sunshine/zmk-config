#include <dt-bindings/zmk/matrix_transform.h>
#include "mks_mkb1.dtsi"
#include <dt-bindings/led/led.h>

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };

    kscan: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;
    };
    /* 2つのマトリクス状態を1つに統合する親ノード */
    kscan0: kscan_composite {
        compatible = "zmk,kscan-composite";
        label = "KSCAN";
        rows = <4>;
        columns = <8>;

        /* 順方向のペアリング（論理ROW 0 と 論理ROW 2） */
        matrix_forward {
            kscan = <&kscan_fw>;
            row-offset = <0>; // 論理行 0, 2 としてマッピング
        };

        /* 逆方向のペアリング（論理ROW 1 と 論理ROW 3） */
        matrix_backward {
            kscan = <&kscan_bw>;
            row-offset = <1>; // 論理行 1, 3 としてマッピング
        };
    };

    /* 順方向用（Anode -> Cathode）マトリクス：2行×8列 */
    kscan_fw: kscan_forward {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        row-gpios
            = <&xiaoble_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // 論理ROW0 (物理ROW0)
            , <&xiaoble_d 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // 論理ROW2 (物理ROW1)
            ;
        col-gpios = <&shift_reg 0 GPIO_ACTIVE_HIGH>
                  , <&shift_reg 1 GPIO_ACTIVE_HIGH>
                  , <&shift_reg 2 GPIO_ACTIVE_HIGH>
                  , <&shift_reg 3 GPIO_ACTIVE_HIGH>
                  , <&shift_reg 4 GPIO_ACTIVE_HIGH>
                  , <&shift_reg 5 GPIO_ACTIVE_HIGH>
                  , <&shift_reg 6 GPIO_ACTIVE_HIGH>
                  , <&shift_reg 7 GPIO_ACTIVE_HIGH>
                  ;
    };

    /* 逆方向用（Cathode -> Anode）マトリクス：2行×8列 */
    kscan_bw: kscan_backward {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "row2col"; // 電流の向きが反転
        row-gpios
            = <&xiaoble_d 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // 論理ROW1 (物理ROW0)
            , <&xiaoble_d 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // 論理ROW3 (物理ROW1)
            ;
        col-gpios = <&shift_reg 0 GPIO_ACTIVE_LOW>
                  , <&shift_reg 1 GPIO_ACTIVE_LOW>
                  , <&shift_reg 2 GPIO_ACTIVE_LOW>
                  , <&shift_reg 3 GPIO_ACTIVE_LOW>
                  , <&shift_reg 4 GPIO_ACTIVE_LOW>
                  , <&shift_reg 5 GPIO_ACTIVE_LOW>
                  , <&shift_reg 6 GPIO_ACTIVE_LOW>
                  , <&shift_reg 7 GPIO_ACTIVE_LOW>
                  ;
    };

    /* 2つのマトリクス状態を1つに統合する親ノード */
    kscan0: kscan_composite {
        compatible = "zmk,kscan-composite";
        label = "KSCAN";
        rows = <4>;
        columns = <8>;

        /* 順方向のペアリング（論理ROW 0 と 論理ROW 2） */
        matrix_forward {
            kscan = <&kscan_fw>;
            row-offset = <0>; // 論理行 0, 2 としてマッピング
        };

        /* 逆方向のペアリング（論理ROW 1 と 論理ROW 3） */
        matrix_backward {
            kscan = <&kscan_bw>;
            row-offset = <1>; // 論理行 1, 3 としてマッピング
        };
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <8>; // シフトレジスタの8列
        rows = <4>;    // Duplex Matrix化による論理的な4行(2ROW × 2パターン)

        /* 
         * ご提示のリストを完璧にRCマッピング化。
         * 左半分(SW1〜30) と 右半分(SW31〜60) を並べています。
         */
        map = <
        /* ================== 左手側 (SW1 〜 SW30) ================== */
        /* SW01:F12 */ RC(0,0)  /* SW06:F1 */  RC(0,1)  /* SW11:F2 */  RC(0,2)  /* SW16:F3 */  RC(0,3)  /* SW21:F4 */  RC(0,4)  /* SW26:F5 */  RC(0,5)
        /* SW02:esc */ RC(1,0)  /* SW07:Q */   RC(1,1)  /* SW12:W */   RC(1,2)  /* SW17:E */   RC(1,3)  /* SW22:R */   RC(1,4)  /* SW27:T */   RC(1,5)
        /* SW03:tab */ RC(2,0)  /* SW08:A */   RC(2,1)  /* SW13:S */   RC(2,2)  /* SW18:D */   RC(2,3)  /* SW23:F */   RC(2,4)  /* SW28:G */   RC(2,5)
        /* SW04:shf */ RC(3,0)  /* SW09:Z */   RC(3,1)  /* SW14:X */   RC(3,2)  /* SW19:C */   RC(3,3)  /* SW24:V */   RC(3,4)  /* SW29:B */   RC(3,5)
        /* SW05:ctl */ RC(0,6)  /* SW10:win */ RC(1,6)  /* SW15:alt */ RC(2,6)  /* SW20:fn */  RC(3,6)  /* SW25:spc */ RC(0,7)  /* SW30:lyt */ RC(2,7)

        /* ================== 右手側 (SW31 〜 SW60) ================== */
        /* SW31:F6 */ RC(0,0)  /* SW36:F7 */  RC(0,1)  /* SW41:F8 */  RC(0,2)  /* SW46:F9 */ RC(0,3)  /* SW51:F10 */RC(0,4)  /* SW56:F11 */RC(0,5)
        /* SW32:Y */  RC(1,0)  /* SW37:U */   RC(1,1)  /* SW42:I */   RC(1,2)  /* SW47:O */  RC(1,3)  /* SW52:P */  RC(1,4)  /* SW57:bs */ RC(1,5)
        /* SW33:H */  RC(2,0)  /* SW38:J */   RC(2,1)  /* SW43:K */   RC(2,2)  /* SW48:L */  RC(2,3)  /* SW53:\ */  RC(2,4)  /* SW58:ent */RC(2,5)
        /* SW34:N */  RC(3,0)  /* SW39:M */   RC(3,1)  /* SW44:, */   RC(3,2)  /* SW49:. */  RC(3,3)  /* SW54:↑ */  RC(3,4)  /* SW59:del */RC(3,5)
        /* SW35:ML */ RC(0,6)  /* SW40:MR */  RC(1,6)  /* SW45:alt */ RC(2,6)  /* SW50:← */  RC(3,6)  /* SW55:↓ */  RC(0,7)  /* SW60:→ */  RC(2,7)
        >;
    };
};

/***************************** 
 trackpad
 ****************************/
&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
                    <NRF_PSEL(TWIM_SCL, 0, 20)>;
            bias-pull-up;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
                    <NRF_PSEL(TWIM_SCL, 0, 20)>;
            bias-pull-up;
            low-power-enable;
        };
    };
};

&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_FAST>;
    zephyr,concat-buf-size = <32>;

    trackpad: trackpad@56 {
        status = "okay";
        compatible = "azoteq,iqs7211e";
        reg = <0x56>;
        irq-gpios = <&xiaoble_d 10 GPIO_PULL_UP>;
        /* 基板の回路設計で、XIAO BLEの「3V3」ピンからトラックパッドのVDDへ直接配線している場合power-gpios は記述しない */
        /* power-gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>;*/
        scroller-mode;
        // v-invert;
    };
};

&i2c1 {
  trackpad1: trackpad@56 {
    status = "okay";
    compatible = "azoteq,iqs7211e";
    reg = <0x56>;
    irq-gpios = <&xiaoble_d 10 GPIO_ACTIVE_LOW>;
    init-symbol = "trackpad1_iqs7211e_init";
  };
};



/***************************** 
 LED
 ****************************/
/ {
    /* 
     * ZMKのRGB Underglowシステムに対して、
     * 制御対象となるLEDストリップ（&led_strip）を紐付けます
     */
    chosen {
        zmk,underglow = &led_strip;
    };
};

/* 
 * D6ピンをSPIのデータ出力（MOSI）として利用するための設定
 */
&spi1 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    
    /* 
     * D6ピン（P1.11）をMOSIピンとして正しくアサイン
     * nRF52840ではポート1のピンは「32 + ピン番号」で数えるため、32 + 11 = 43 となります。
     */
    mosi-pin = <43>; 
    
    /* SPI通信を極小化するため、不必要なMISOやSCKは無効（未使用ピン）に設定 */
    sck-pin = <0xFFFFFFFF>;
    miso-pin = <0xFFFFFFFF>;

    /* LEDストリップ（SK6805）のノード定義 */
    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        label = "SK6805";
        reg = <0>; /* SPIのチップセレクト（ダミー） */
        spi-max-frequency = <4000000>;

        /* 重要：15個のLEDが直列されている仕様を指定 */
        chain-length = <15>; 
        
        /* カラー順序（SK6805-EC20は一般的に「緑・赤・青」の順でデータを要求します） */
        color-mapping = <LED_COLOR_CHANNELS_RGB>; 
        /* 
         * ※もし色が「赤と緑が逆」になる場合は、上記を 
         * color-mapping = <LED_COLOR_CHANNELS_GRB>; に変更してください。
         */
    };
};

/***************************** 
 5V Boost
 ****************************/
/ {
    /*
     * 5V昇圧IC（Boost）の制御ピン（D7 / P1.12）の定義
     * ポート1の12番ピンなので、gpio1 の 12番 を指定します。
     */
    boost_en: boost_en {
        compatible = "regulator-fixed";
        label = "5V_BOOST_EN";
        /* 
         * gpio1: ポート1 (P1.xx) 
         * 12: ピン番号12 (P1.12)
         * GPIO_ACTIVE_HIGH: Highで昇圧ICがONになる回路を想定
         */
        gpio = <&gpio1 12 GPIO_ACTIVE_HIGH>;
        regulator-name = "boost_en";
        enable-active-high;
    };

    /*
     * ZMKの外部電源管理（ext-power）システムに昇圧ピンを紐付けます。
     * これにより、LEDのON/OFFやスリープ状態と連動してD7ピンが自動制御されます。
     */
    ext-power {
        compatible = "zmk,ext-power-generic";
        label = "EXT_POWER";
        control-gpios = <&gpio1 12 GPIO_ACTIVE_HIGH>;
    };
};
