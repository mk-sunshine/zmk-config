#include "mks_mkb1.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
    };
};

/* 右手側にも独立した74HC595が存在するため、同様にSPI0を定義 */
&spi0 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    
    sck-pin = <0>;  // D0ピン：SRCLK
    mosi-pin = <2>; // D2ピン：SER
    cs-gpios = <&xiao_d 1 GPIO_ACTIVE_LOW>; // D1ピン：RCLK

    shift_reg: 595@0 {
        compatible = "zmk,gpio-595";
        status = "okay";
        reg = <0>;
        spi-max-frequency = <200000>;
        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <8>;
    };
};